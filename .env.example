# Clé publique VAPID — identique à VAPID_PUBLIC_KEY (générée avec `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- API (dossier server/) ---
# Base Neon : poolée pour l'appli, directe pour les migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
JWT_SECRET=
# JWT_EXPIRES_IN=90d

# Stockage S3 (obligatoire sur Vercel : le disque y est effacé)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# En local sans S3 : fichiers dans ./storage
# STORAGE_ROOT=

# Notifications Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Secret des tâches automatiques (/api/cron/...) : Vercel l'envoie tout seul, cron-job.org doit l'envoyer en en-tête
CRON_SECRET=
